import faulthandler, os
LOG = os.path.join(os.path.dirname(os.path.abspath(__file__)), "debug_log.txt")
_f = open(LOG, "w", buffering=1, encoding="utf-8")
faulthandler.enable(file=_f, all_threads=True)

def log(msg):
    _f.write(msg + "\n"); _f.flush(); os.fsync(_f.fileno())
import cv2, time, pyautogui
import mediapipe as mp
mp_hands=mp.solutions.hands
hands=mp_hands.Hands(max_num_hands=1,min_detection_confidence=0.7)
mp_drawing=mp.solutions.drawing_utils
SCROLL_SPEED=300
SCROLL_DELAY=1
CAM_WIDTH,CAM_HEIGHT=640,480
def detect_gesture(landmarks,handedness):
    fingers=[]
    tips=[mp_hands.HandLandmark.INDEX_FINGER_TIP,
          mp_hands.HandLandmark.MIDDLE_FINGER_TIP,
          mp_hands.HandLandmark.RING_FINGER_TIP,
          mp_hands.HandLandmark.PINKY_TIP]
    for tip in tips:
        if landmarks.landmark[tip].y<landmarks.landmark[tip-2].y:
            fingers.append(1)
    thumb_tip=landmarks.landmark[mp_hands.HandLandmark.THUMB_TIP]
    thumb_ip=landmarks.landmark[mp_hands.HandLandmark.THUMB_IP]
    if (handedness=="Right" and thumb_tip.x>thumb_ip.x) or (handedness=="Left" and thumb_tip.x<thumb_ip.x):
        fingers.append(1)
    return "scroll_up" if sum(fingers)==5 else "scroll_down" if len(fingers)==0 else 'none'
cap=cv2.VideoCapture(0, cv2.CAP_DSHOW)
cap.set(cv2.CAP_PROP_FRAME_WIDTH, CAM_WIDTH)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, CAM_HEIGHT)
if not cap.isOpened():
    print("Error: Webcam not accessible"); exit()
print("Camera opened")
last_scroll=p_time=0
print("Gesture scroll control active\nOpen palm: Scroll up\nFist: Scroll down\n press 'q' to exit")
while cap.isOpened():
    success,img=cap.read()
    if not success:
        print("Could not capture camera")
        break
    log("frame read")
    img=cv2.flip(cv2.cvtColor(img,cv2.COLOR_BGR2RGB),1)
    log("flipped")
    results=hands.process(img)
    log("processed")
    img.flags.writeable = True
    print("frame OK", img.shape)
    gesture,handedness="none","Unknown"
    if results.multi_hand_landmarks:
        log("hand found")
        for hand,handedness_info in zip(results.multi_hand_landmarks,results.multi_handedness):
            handedness=handedness_info.classification[0].label
            gesture=detect_gesture(hand,handedness)
            mp_drawing.draw_landmarks(img,hand,mp_hands.HAND_CONNECTIONS)
            if (time.time()-last_scroll)>SCROLL_DELAY:
                if gesture=='scroll_up':
                    pyautogui.scroll(SCROLL_SPEED)
                elif gesture=='scroll_down':
                    pyautogui.scroll(-SCROLL_SPEED)
                last_scroll=time.time()
    fps=1/(time.time()-p_time) if (time.time()-p_time)>0 else 0
    p_time=time.time()
    log("before putText")
    try:
        text = f"FPS: {int(fps)} | Hand: {handedness} | Gesture: {gesture}"
        cv2.putText(img, text, (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 0, 0), 2)
    except Exception as e:
        import traceback
        log("putText failed: " + traceback.format_exc())
        break
    log("before imshow")
    cv2.imshow("Gesture Control", cv2.cvtColor(img, cv2.COLOR_RGB2BGR))
    log("after imshow")
    key = cv2.waitKey(1)
    print("after waitKey", key)
    if key & 0xFF == ord('q'):
        break
cap.release()
cv2.destroyAllWindows()